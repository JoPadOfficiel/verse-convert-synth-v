+using System.Text.RegularExpressions;
+
+namespace OpenUtau.App.Controls {
+    /// <summary>
+    /// The readable caption of a note. Its stored lyric and pronunciation input
+    /// remain available in the lyric editor and to the phonemizer.
+    /// </summary>
+    public static class NoteLyricDisplay {
+        // Match UNote.ToPhonemizerNote's greedy, line-local bracket syntax.
+        // NonBacktracking keeps repeated painting linear for malformed input.
+        static readonly Regex PhoneticHint = new Regex(
+            @"\[(.*)\]", RegexOptions.NonBacktracking);
+
+        public static string GetText(string lyric) {
+            string text = PhoneticHint.Replace(lyric, string.Empty);
+            if (text.Length == lyric.Length) {
+                return lyric;
+            }
+            text = text.Trim();
+            // A phoneme-only note still needs a visible, selectable caption.
+            // It also protects the canvas's narrow-note abbreviation at [0].
+            return text.Length == 0 ? lyric : text;
+        }
+    }
+}
